{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Claims Demo Policy",
          "rules": [
            {
              "id": "DEMO001",
              "name": "SyntheticAuditMarker",
              "shortDescription": {
                "text": "The synthetic, payload-free audit marker is disabled."
              },
              "fullDescription": {
                "text": "Training-only policy for a dummy event with no payload."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "DEMO001",
          "level": "warning",
          "message": {
            "text": "The synthetic, payload-free audit marker is disabled."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "audit_marker.py"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
