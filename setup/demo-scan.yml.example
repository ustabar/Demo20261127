name: Demo policy scan
on:
  workflow_dispatch:
permissions:
  actions: read
  contents: read
  security-events: write
jobs:
  scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-python@v6
        with:
          python-version: '3.12'
      - name: Create synthetic finding
        run: python scan_demo.py --sarif demo-results.sarif
      - name: Upload training-only findings
        uses: github/codeql-action/upload-sarif@v4
        with:
          sarif_file: demo-results.sarif
          category: claims-demo-policy
